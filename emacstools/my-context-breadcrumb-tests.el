(ert-deftest audit-multiple-windows ()
  (audit-context audit-python #'python-ts-mode
    (let* ((one (selected-window)) (two (split-window-right)))
      (goto-char (point-min)) (search-forward "return 1")
      (set-window-point one (point))
      (goto-char (point-min)) (search-forward "return 2")
      (set-window-point two (point))
      (set-window-point one (save-excursion (goto-char (point-min)) (search-forward "return 1")))
