(ert-deftest audit-else-hint-policies ()
  (audit-context "void f() { if(ok) { yes(); } else { no(); } }" #'c++-ts-mode
    (goto-char (point-min)) (search-forward "no();")
    (let* ((entry (cl-find "else" (my/context-breadcrumb-entries)
                           :key #'my/context-breadcrumb--entry-label :test #'equal))
           (my/context-breadcrumb-icons t))
      (dolist (policy '(always offscreen off))
        (let ((my/context-breadcrumb-else-hints policy))
          (dolist (visible '(t nil))
            (cl-letf (((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) visible)))
              (let ((text (my/context-breadcrumb--segment entry 100 (selected-window) t)))
                (should (eq (and (string-match-p "if(ok)" text) t)
                            (or (eq policy 'always) (and (eq policy 'offscreen) (not visible)))))
                (when (string-match-p "if(ok)" text)
                  (should (string-match-p (char-to-string #xebba) text)))))))))))

