(ert-deftest audit-font-customization-and-icon-family ()
  (let ((my/context-breadcrumb-font-family "JetBrains Mono")
        (my/context-breadcrumb-font-size 140)
        (my/context-breadcrumb-face-attributes
         '(:foreground "cyan" :weight light :slant italic :underline t))
        (my/context-breadcrumb-current-weight nil))
    (let* ((text (concat (propertize "I" 'face '(:family "Symbols Nerd Font Mono" :height 0.9)
                                     'my/context-breadcrumb-icon t)
                         (propertize " Label" 'face 'org-level-1)))
           (result (my/context-breadcrumb--normalize-text text))
           (icon (get-text-property 0 'face result))
           (face (get-text-property 2 'face result)))
      (should (equal (plist-get icon :family) "Symbols Nerd Font Mono"))
      (should (= (plist-get icon :height) 140))
      (should (equal (plist-get face :family) "JetBrains Mono"))
      (should (= (plist-get face :height) 140))
      (should (eq (plist-get face :weight) 'light))
      (should (eq (plist-get face :slant) 'italic))
      (should (plist-get face :underline))
      (should (equal (plist-get face :foreground) "cyan"))
      (let ((my/context-breadcrumb-current-weight 'semibold))
        (put-text-property 0 (length text) 'my/context-breadcrumb-current t text)
        (my/context-breadcrumb--normalize-text text)
        (should (eq (plist-get (get-text-property 2 'face text) :weight) 'semibold))))))

