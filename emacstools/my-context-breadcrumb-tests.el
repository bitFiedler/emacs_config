(ert-deftest audit-debug-toggle-and-decisions ()
  (let ((my/context-breadcrumb-debug nil))
    (my/context-breadcrumb-debug-clear)
    (when-let* ((buffer (get-buffer my/context-breadcrumb--debug-buffer))) (kill-buffer buffer))
    (unwind-protect
        (audit-context audit-python #'python-ts-mode
          (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) 24))
                    ((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) nil)))
            (let ((original (my/context-breadcrumb-render)))
              (should-not my/context-breadcrumb--debug-queue)
              (my/context-breadcrumb-debug-toggle)
              (should my/context-breadcrumb-debug)
              (should (equal original (my/context-breadcrumb-render)))
              (should my/context-breadcrumb--debug-queue)
              ;; Redisplay only queued diagnostics; it did not modify a log buffer.
              (should-not (get-buffer my/context-breadcrumb--debug-buffer))
              (let ((queued my/context-breadcrumb--debug-queue-size))
                (my/context-breadcrumb--update)
                (my/context-breadcrumb-render)
                (should (= queued my/context-breadcrumb--debug-queue-size)))
              (my/context-breadcrumb--debug-flush)
              (with-current-buffer (get-buffer my/context-breadcrumb--debug-buffer)
                (let ((text (buffer-string)))
                  (dolist (term '("RENDER" "parser=python" "ancestor nodes="
                                  "active elif/else supersedes if" "selected scopes="
                                  "reason=offscreen-header" "fit: available="
                                  "hide outer section" "fit result:"))
                    (should (string-match-p (regexp-quote term) text)))))
              (my/context-breadcrumb-debug-toggle)
              (should-not my/context-breadcrumb-debug)
              (my/context-breadcrumb-render)
              (should-not my/context-breadcrumb--debug-queue))))
      (my/context-breadcrumb-debug-clear)
      (when-let* ((buffer (get-buffer my/context-breadcrumb--debug-buffer))) (kill-buffer buffer)))))

(ert-deftest audit-debug-log-bounds-and-render-errors ()
  (let ((my/context-breadcrumb-debug t)
        (my/context-breadcrumb-debug-max-lines 3))
    (my/context-breadcrumb-debug-clear)
    (unwind-protect
        (progn
          (audit-context audit-python #'python-ts-mode
            (cl-letf (((symbol-function 'my/context-breadcrumb-entries)
                       (lambda (&rest _) (error "test render failure"))))
              (should (equal (my/context-breadcrumb-render) "")))
            (my/context-breadcrumb--debug-flush)
            (with-current-buffer (get-buffer my/context-breadcrumb--debug-buffer)
              (should (string-match-p "RENDER ERROR: test render failure" (buffer-string)))))
          (dotimes (i 10) (my/context-breadcrumb--debug-enqueue (format "bounded line %d" i)))
          (my/context-breadcrumb--debug-flush)
          (with-current-buffer (get-buffer my/context-breadcrumb--debug-buffer)
            (should (<= (count-lines (point-min) (point-max)) 3))
            (should (string-match-p "bounded line 9" (buffer-string)))))
      (my/context-breadcrumb-debug-clear)
      (when-let* ((buffer (get-buffer my/context-breadcrumb--debug-buffer))) (kill-buffer buffer)))))

(ert-deftest audit-continuous-background-and-remap-restoration ()
  (let ((my/context-breadcrumb-background "#101010")
        (my/context-breadcrumb-border nil)
        (my/context-breadcrumb-position 'top)
        (global-box (face-attribute 'header-line :box nil t)))
    (audit-context audit-python #'python-ts-mode
      (let* ((remap (cadr (assq 'header-line face-remapping-alist)))
             (entry (car (last (my/context-breadcrumb-entries))))
             (text (my/context-breadcrumb--segment entry 80 (selected-window) nil)))
        (should (equal (plist-get remap :background) "#101010"))
        (should (plist-member remap :box))
        (should-not (plist-get remap :box))
        (should-not (plist-get (get-text-property (string-match "return" text) 'face text)
                               :background))
        (should-not (plist-get (get-text-property (string-match "return" text) 'face text) :box))
        (should (eq (get-text-property 0 'mouse-face text) 'my/context-breadcrumb-hover)))
      (setq my/context-breadcrumb-border "#ff0000")
      (my/context-breadcrumb-refresh)
      (should (equal (plist-get (cadr (assq 'header-line face-remapping-alist)) :box)
                     '(:line-width 1 :color "#ff0000")))
      (my/context-breadcrumb-toggle-position)
      (should-not (assq 'header-line face-remapping-alist))
      (should-not (assq 'mode-line face-remapping-alist))
      (my/context-breadcrumb-mode -1)
      (should-not my/context-breadcrumb--face-cookies)
      (should-not (assq 'mode-line face-remapping-alist))
      (should (equal global-box (face-attribute 'header-line :box nil t))))))

(defconst audit-cpp-catch
  "int main(int argc, char * argv[])\n{\n    try\n    {\n        run();\n    }\n    catch(std::exception const & e)\n    {\n        if(!in_initrd)\n        {\n            LEO_LOGIF_ERROR(logger, \"Parsing of command line options failed: \" << e.what());\n            LEe::Command_line_config::print_usage();\n        }\n        return static_cast<int>(LEe::Return_value::Exit_failure);\n    }\n}\n")

(ert-deftest audit-catch-active-path-and-macro-toggle ()
  (let ((my/context-breadcrumb-show-file nil)
        (my/context-breadcrumb-show-statements t)
        (my/context-breadcrumb-show-macro-calls nil)
        (my/context-breadcrumb-detail 'always))
    (audit-context audit-cpp-catch #'c++-ts-mode
      (goto-char (point-min)) (search-forward "LEO_LOGIF_ERROR(logger")
      (should (equal (audit-labels)
                     '("main" "catch(std::exception const & e)" "if(!in_initrd)")))
      (setq my/context-breadcrumb-show-macro-calls t)
      (should (eq (my/context-breadcrumb--entry-kind (car (last (my/context-breadcrumb-entries)))) 'macro))
      (should (string-prefix-p "LEO_LOGIF_ERROR" (car (last (audit-labels)))))
      (setq my/context-breadcrumb-show-macro-calls nil)
      (goto-char (point-min)) (search-forward "print_usage()")
      (should (equal (car (last (audit-labels))) "LEe::Command_line_config::print_usage()"))
      (setq my/context-breadcrumb-show-statements nil)
      (should (equal (audit-labels)
                     '("main" "catch(std::exception const & e)" "if(!in_initrd)")))
      (goto-char (point-min)) (search-forward "run();")
      (should (equal (audit-labels) '("main" "try"))))))

