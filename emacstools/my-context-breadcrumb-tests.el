(ert-deftest audit-cpp-else-if-chain-is-one-active-branch ()
  (let ((my/context-breadcrumb-show-file nil)
        (my/context-breadcrumb-detail 'always))
    (audit-context "int main() {\n try {\n  if(command == Explode) { explode(); }\n  else if(command == Implode) { implode(); }\n  else if(command == Set) { set(); }\n  else if(command == Get) { get(); }\n  else if(command_line_config->command == LEe::Command::Verify) {\n   std::string verify_dir;\n  } else { fallback(); }\n } catch(...) {}\n}\n" #'c++-ts-mode
      (search-backward "verify_dir")
      (should (equal (audit-labels)
                     '("main" "try" "else if(command_line_config->command == LEe::Command::Verify)")))
      ;; Clicking/navigation lands at the whole branch's else keyword.
      (my/context-breadcrumb-statement)
      (should (looking-at "else if(command_line_config->command == LEe::Command::Verify)"))
      (goto-char (point-min)) (search-forward "explode();")
      (should (member "if(command == Explode)" (audit-labels)))
      (goto-char (point-min)) (search-forward "fallback();")
      (let ((my/context-breadcrumb-show-statements nil))
        (should (= (length (audit-labels)) 3))
        (should (string-prefix-p "else" (car (last (audit-labels)))))))))

