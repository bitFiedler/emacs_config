(ert-deftest audit-bottom-footer-separate-row-and-status ()
  (let ((my/context-breadcrumb-position 'bottom))
    (audit-context audit-python #'python-ts-mode
      (setq-local mode-line-format '("Normal status"))
      (my/context-breadcrumb-refresh)
      (let* ((source (selected-window))
             (state (gethash source my/context-breadcrumb--bottom-windows))
             (footer (plist-get state :window))
             (buffer (plist-get state :buffer)))
        (should (window-live-p footer))
        (should (equal mode-line-format '("Normal status")))
        (should (eq (window-parameter source 'mode-line-format) 'none))
        (should (eq (my/context-breadcrumb--source-window footer) source))
        (should (eq (window-buffer source) (current-buffer)))
        (should (= (window-total-height footer) 2))
        (should (= (nth 3 (window-edges source)) (nth 1 (window-edges footer))))
        (should (with-current-buffer buffer (string-match-p "return" (buffer-string))))
        (with-current-buffer buffer
          (cl-letf (((symbol-function 'format-mode-line)
                     (lambda (format &rest _) (format "%S" format))))
            (should (equal (my/context-breadcrumb--bottom-mode-line) "(\"Normal status\")"))))
        ;; A footer click must target the source, never replace the footer buffer.
        (my/context-breadcrumb--jump (car (last (my/context-breadcrumb-entries)))
                                     (current-buffer) footer)
        (should (eq (selected-window) source))
        (should (eq (window-buffer footer) buffer))
        (my/context-breadcrumb-toggle-position)
        (should-not (window-live-p footer))
        (should-not (buffer-live-p buffer))
        (should-not (window-parameter source 'mode-line-format))
        (should (equal mode-line-format '("Normal status")))))))

(ert-deftest audit-bottom-footer-split-windows-and-buffer-switch ()
  (let ((my/context-breadcrumb-position 'bottom))
    (audit-context audit-python #'python-ts-mode
      (let* ((source (selected-window))
             (other (split-window source nil 'right)))
        (set-window-buffer other (current-buffer))
        (my/context-breadcrumb--bottom-sync)
        (let* ((state (gethash source my/context-breadcrumb--bottom-windows))
               (other-state (gethash other my/context-breadcrumb--bottom-windows))
               (footer (plist-get state :window)))
          (should (window-live-p footer))
          (should (window-live-p (plist-get other-state :window)))
          (should-not (eq footer (plist-get other-state :window)))
          (should (= (window-total-width source) (window-total-width footer)))
          (should (= (window-total-width other)
                     (window-total-width (plist-get other-state :window))))
          (set-window-buffer other (get-buffer-create " *breadcrumb unrelated*"))
          (my/context-breadcrumb--bottom-sync)
          (should-not (gethash other my/context-breadcrumb--bottom-windows))
          (should-not (window-live-p (plist-get other-state :window)))
          (should (window-live-p footer))
          (kill-buffer " *breadcrumb unrelated*"))))))

