(ert-deftest audit-helm-full-path-and-origin-navigation ()
  (require 'helm)
  (require 'helm-source)
  (let ((my/context-breadcrumb-show-file nil)
        (my/context-breadcrumb-icons nil))
    (audit-context "namespace Outer { void run() { if(flag) { work(); } } }" #'c++-ts-mode
      (goto-char (point-min)) (search-forward "work")
      (let ((origin (point)) (source-buffer (current-buffer)) captured)
        (should (eq (lookup-key my/context-breadcrumb-mode-map (kbd "C-c . h"))
                    #'my/context-breadcrumb-helm))
        (cl-letf (((symbol-function 'helm)
                   (lambda (&rest args) (setq captured (car (plist-get args :sources))))))
          (my/context-breadcrumb-helm))
        (should (= (point) origin))
        (let* ((candidates (cdr (assq 'candidates captured)))
               (function (cl-find-if
                          (lambda (candidate)
                            (eq (my/context-breadcrumb--entry-kind (cdr candidate)) 'function))
                          candidates))
               (action (cdar (cdr (assq 'action captured)))))
          (should (equal (mapcar (lambda (c) (my/context-breadcrumb--entry-label (cdr c)))
                                candidates)
                         (audit-labels)))
          (should (string-match-p "run.*function.*line 1" (car function)))
          ;; Marker targets survive edits, and actions return from Helm's buffer.
          (goto-char (point-min)) (insert "// inserted\n")
          (with-temp-buffer (funcall action (cdr function)))
          (should (eq (current-buffer) source-buffer))
          (should (looking-at "void run"))
          (xref-go-back)
          (should (= (point) (1+ (length "// inserted\n")))))))))

