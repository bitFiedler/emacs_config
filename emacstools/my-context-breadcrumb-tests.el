;;; -*- lexical-binding: t; -*-
(require 'package)
(package-initialize)
(require 'ert)
(load (expand-file-name "my-context-breadcrumb.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(defconst audit-python
  "class Controller:\n    def dispatch(self, event):\n        if event.ready:\n            return 1\n        elif event.failed:\n            return 2\n        else:\n            match event.kind:\n                case 'restart':\n                    return event.result\n")
(defmacro audit-context (source mode &rest body)
  (declare (indent 2))
  `(save-window-excursion
     (with-temp-buffer
       (insert ,source)
       (funcall ,mode)
       (set-window-buffer (selected-window) (current-buffer))
       (goto-char (point-max))
       (my/context-breadcrumb-mode 1)
       (unwind-protect (progn ,@body) (my/context-breadcrumb-mode -1)))))
(defun audit-labels ()
  (mapcar #'my/context-breadcrumb--entry-label (my/context-breadcrumb-entries)))

(ert-deftest audit-python-branch-context ()
  (audit-context audit-python #'python-ts-mode
    (should (equal (cdr (audit-labels))
                   '("Controller" "dispatch" "else"
                     "match event.kind" "case 'restart'" "return event.result")))
    (goto-char (point-min)) (search-forward "return 2")
    (should (equal (cdr (audit-labels))
                   '("Controller" "dispatch" "elif event.failed" "return 2")))
    (goto-char (point-min)) (search-forward "return 1")
    (should (member "if event.ready" (audit-labels)))))

(ert-deftest audit-cpp-scope-and-case ()
  (audit-context "namespace Net { class Worker { int run(int x) {\nif (x) { return 1; } else { return 2; }\nswitch(x) { case 7: return 3; default: return 0; }\n} }; }" #'c++-ts-mode
    (goto-char (point-min)) (search-forward "return 3")
    (should (equal (cdr (audit-labels))
                   '("Net" "Worker" "run" "switch (x)" "case 7" "return 3")))
    (goto-char (point-min)) (search-forward "return 0")
    (should (member "default" (audit-labels)))
    (goto-char (point-min)) (search-forward "return 2")
    (should (member "else" (audit-labels)))
    (should-not (member "if (x)" (audit-labels)))))

(ert-deftest audit-offscreen-detail-and-icons ()
  (audit-context audit-python #'python-ts-mode
    (let* ((entry (cl-find-if (lambda (e) (equal (my/context-breadcrumb--entry-label e)
                                                "match event.kind"))
                             (my/context-breadcrumb-entries)))
           (my/context-breadcrumb-detail 'offscreen))
      (cl-letf (((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) t)))
        (should-not (string-match-p "event.kind" (my/context-breadcrumb--segment entry 80 (selected-window) nil))))
      (cl-letf (((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) nil)))
        (should (string-match-p "event.kind" (my/context-breadcrumb--segment entry 80 (selected-window) nil)))))
    (dolist (pair my/context-breadcrumb--icons)
      (should (stringp (nerd-icons-codicon (cdr pair)))))))

(ert-deftest audit-narrow-fitting ()
  (audit-context audit-python #'python-ts-mode
    (let ((entries (my/context-breadcrumb-entries)))
      (dolist (width '(1 3 5 10 20 35 60 120))
        (let ((text (my/context-breadcrumb--fit entries width (selected-window))))
          (should (<= (string-width text) width))
          (when (>= width 20) (should (string-match-p "return" text)))))
      (let* ((text (my/context-breadcrumb--fit entries 35 (selected-window)))
             (map (get-text-property 0 'local-map text)))
        (should (string-prefix-p "…" text))
        (should (commandp (lookup-key map [header-line mouse-1])))))))

(ert-deftest audit-top-bottom-and-restore ()
  (save-window-excursion
    (with-temp-buffer
      (insert audit-python) (python-ts-mode)
      (setq-local header-line-format '("Existing header")
                  mode-line-format '("Existing status"))
      (let ((my/context-breadcrumb-position 'top))
        (my/context-breadcrumb-mode 1)
        (should (equal mode-line-format '("Existing status")))
        (should (equal header-line-format (list my/context-breadcrumb--format)))
        (my/context-breadcrumb-toggle-position)
        (should (equal header-line-format '("Existing header")))
        (should (equal mode-line-format '("Existing status")))
        (my/context-breadcrumb-mode -1)
        (should (equal header-line-format '("Existing header")))
        (should (equal mode-line-format '("Existing status")))))))

