;;; my-helm-files-tests.el --- Helm safety and split layout checks -*- lexical-binding: t; -*-
(defconst my/export-test-directory (file-name-directory (or load-file-name buffer-file-name)))
(require 'ert)
(require 'package)
(package-initialize)
(load-file (expand-file-name "my-helm-files.el" my/export-test-directory))

(ert-deftest my/helm-finished-buffer-is-protected-and-can-be-reused ()
  (with-temp-buffer
    (helm-major-mode)
    (insert "candidate\n")
    (let ((helm-buffer (buffer-name))
          (helm--local-variables nil))
      (my/helm-lock-finished-results)
      (should buffer-read-only)
      (should-error (insert "accidental change") :type 'buffer-read-only)
      ;; Exercise Helm's actual setup rather than assuming read-only
      ;; would be cleared on reuse.
      (helm-create-helm-buffer)
      (should-not buffer-read-only)
      (insert "next candidate\n")
      (my/helm-lock-finished-results)
      (should buffer-read-only))))

(ert-deftest my/helm-wide-picker-preserves-editor-splits ()
  (save-window-excursion
    (delete-other-windows)
    (let ((left (selected-window))
          (right (split-window-right))
          (buffer (generate-new-buffer " *helm-wide-test*")))
      (unwind-protect
          (let ((picker (my/helm-files-display-buffer (buffer-name buffer))))
            (should (eq (window-buffer picker) buffer))
            (should (window-live-p left))
            (should (window-live-p right))
            (should (= (window-total-width picker)
                       (window-total-width (frame-root-window))))
            (should (eq (window-parameter picker 'window-side) 'bottom))
            (should (= (length (window-list)) 3)))
        (when (get-buffer-window buffer) (delete-window (get-buffer-window buffer)))
        (kill-buffer buffer)))))

(ert-deftest my/helm-file-presentation-is-session-local-and-input-editable ()
  (let ((helm-display-function 'original-display)
        (helm-full-frame t)
        (helm-echo-input-in-header-line t)
        (my/helm-files-wide-window t)
        (my/helm-files-edit-in-minibuffer t))
    (should
     (eq (my/helm-files--session
          (lambda (argument)
            (should my/helm-files--active)
            (should (eq helm-display-function 'my/helm-files-display-buffer))
            (should-not helm-full-frame)
            (should-not helm-echo-input-in-header-line)
            (with-temp-buffer
              (my/helm-files--minibuffer-setup)
              (insert "/a/long/path/that/remains/fully/editable")
              (should-not buffer-read-only)
              (should-not truncate-lines)
              (should resize-mini-windows))
            argument)
          'answer)
         'answer))
    (should (eq helm-display-function 'original-display))
    (should helm-full-frame)
    (should helm-echo-input-in-header-line)
    (should-not my/helm-files--active)))

(ert-deftest my/helm-inactive-buffer-lock-skips-current-live-session ()
  (let ((active (generate-new-buffer "*helm safety active*"))
        (inactive (generate-new-buffer "*helm safety old*")))
    (unwind-protect
        (progn
          (with-current-buffer active (helm-major-mode))
          (with-current-buffer inactive (helm-major-mode))
          (let ((helm-alive-p t) (helm-buffer (buffer-name active)))
            (my/helm-lock-inactive-results)
            (with-current-buffer active (should-not buffer-read-only))
            (with-current-buffer inactive (should buffer-read-only))))
      (kill-buffer active) (kill-buffer inactive))))

(ert-deftest my/helm-return-to-source-directory-ignores-path-at-point ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/project/main.cpp"
          default-directory "/tmp/")
    (insert "/var/log/unrelated.log")
    (let ((helm-current-buffer (current-buffer))
          (helm-alive-p t)
          (my/helm-files--active t)
          input)
      (cl-letf (((symbol-function 'helm-set-pattern)
                 (lambda (pattern &rest _) (setq input pattern))))
        (my/helm-files-origin-directory)
        (should (equal input "/tmp/project/"))
        (setq buffer-file-name nil)
        (my/helm-files-origin-directory)
        (should (equal input "/tmp/"))
        (let ((helm-current-buffer nil))
          (should-error (my/helm-files-origin-directory) :type 'user-error))
        (let ((my/helm-files--active nil))
          (should-error (my/helm-files-origin-directory) :type 'user-error)))))
  (should (eq (lookup-key helm-find-files-map (kbd "C-c C-b"))
              'my/helm-files-origin-directory))
  (should (eq (lookup-key helm-find-files-map (kbd "C-c C-o"))
              'helm-ff-run-switch-other-frame)))

(ert-run-tests-batch-and-exit)
