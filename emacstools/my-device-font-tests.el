;;; my-device-font-tests.el --- Device selection checks -*- lexical-binding: t; -*-
(require 'ert)
(load (expand-file-name "my-device-font.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest my/device-font-hostname-selection ()
  (should (= (my/device-font-size "N900D9658") 9))
  (should (= (my/device-font-size "n900d9658.example.org") 9))
  (should (= (my/device-font-size "MP-LINUX") 11))
  (should (= (my/device-font-size "unlisted-device") 11))
  (let ((my/device-font-sizes '(("custom-host" . 12)))
        (my/device-font-default-size 9))
    (should (= (my/device-font-size "CUSTOM-HOST.local") 12))
    (should (= (my/device-font-size "unlisted-device") 9))))

(ert-deftest my/device-font-applies-to-gui-frames-only-and-new-frame-default ()
  (let ((default-frame-alist nil)
        (after-make-frame-functions nil)
        applied)
    (cl-letf (((symbol-function 'system-name) (lambda () "N900D9658"))
              ((symbol-function 'frame-list) (lambda () '(gui tty)))
              ((symbol-function 'display-graphic-p) (lambda (frame) (eq frame 'gui)))
              ((symbol-function 'set-frame-parameter)
               (lambda (frame parameter value) (push (list frame parameter value) applied))))
      (my/apply-device-font)
      (my/apply-device-font)
      (should (equal applied '((gui font "JetBrains Mono-9")
                               (gui font "JetBrains Mono-9"))))
      (should (equal (alist-get 'font default-frame-alist) "JetBrains Mono-9"))
      (should (= (length after-make-frame-functions) 1))
      (setq applied nil)
      (run-hook-with-args 'after-make-frame-functions 'gui)
      (should (equal applied '((gui font "JetBrains Mono-9")))))))

(ert-run-tests-batch-and-exit)
