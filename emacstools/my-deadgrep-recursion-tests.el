;;; my-deadgrep-recursion-tests.el --- Recursion control checks -*- lexical-binding: t; -*-
(require 'package)
(package-initialize)
(require 'ert)
(load (expand-file-name "my-deadgrep-recursion.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest my/deadgrep-default-and-independent-state ()
  (with-temp-buffer
    (deadgrep-mode)
    (should my/deadgrep-recursive-p)
    (setq my/deadgrep-recursive-p nil)
    (deadgrep-mode)
    (should-not my/deadgrep-recursive-p)
    (with-temp-buffer
      (deadgrep-mode)
      (should my/deadgrep-recursive-p)))
  (should (eq (lookup-key deadgrep-mode-map (kbd "R")) 'my/deadgrep-toggle-recursive)))

(ert-deftest my/deadgrep-depth-ownership-and-preserved-arguments ()
  (let* ((original '("--no-config" "--max-depth" "4" "--maxdepth=3" "-d2"
                     "--maxdepth" "2" "-d" "7" "--max-depth=9" "--follow"))
         (deadgrep-extra-arguments (copy-sequence original)))
    (with-temp-buffer
      (deadgrep-mode)
      (let ((arguments (deadgrep--arguments "--max-depth=TEXT" 'string 'smart nil)))
        (should (member "--no-config" arguments))
        (should (member "--follow" arguments))
        (should (member "--max-depth=TEXT" arguments))
        (should-not (member "--max-depth=1" arguments))
        (should-not (member "--max-depth=9" arguments)))
      (setq my/deadgrep-recursive-p nil)
      (should (member "--max-depth=1" (deadgrep--arguments "needle" 'string 'smart nil)))
      (should (equal deadgrep-extra-arguments original)))))

(ert-deftest my/deadgrep-header-buttons-and-toggle ()
  (with-temp-buffer
    (deadgrep-mode)
    (setq deadgrep--search-term "needle")
    (deadgrep--write-heading)
    (goto-char (point-min)) (search-forward "Recursive: on ")
    (let ((button (button-at (point))) (restarts 0))
      (should button)
      (should (get-text-property (point) 'read-only))
      (cl-letf (((symbol-function 'deadgrep-restart) (lambda () (cl-incf restarts))))
        (button-activate button)
        (should-not my/deadgrep-recursive-p)
        (should (= restarts 1))
        (my/deadgrep-set-recursive nil)
        (should (= restarts 1))
        (let ((inhibit-read-only t)) (erase-buffer))
        (deadgrep--write-heading)
        (goto-char (point-min)) (search-forward "Recursive: ")
        (button-activate (button-at (point)))
        (should my/deadgrep-recursive-p)
        (should (= restarts 2))))))

(ert-deftest my/deadgrep-idempotent-extension-reload ()
  (let ((file (expand-file-name "my-deadgrep-recursion.el"
                                (file-name-directory (symbol-file 'my/deadgrep-toggle-recursive))))
        (argument-advice 0) (heading-advice 0))
    (load file nil t) (load file nil t)
    (advice-mapc (lambda (function _properties)
                  (when (eq function 'my/deadgrep--arguments-with-recursion) (cl-incf argument-advice)))
                'deadgrep--arguments)
    (advice-mapc (lambda (function _properties)
                  (when (eq function 'my/deadgrep--write-recursion) (cl-incf heading-advice)))
                'deadgrep--write-heading)
    (should (= argument-advice 1))
    (should (= heading-advice 1))
    (dolist (entry '((deadgrep--start . my/deadgrep--start-with-recursion)
                     (start-file-process . my/deadgrep--launch-arguments)))
      (let ((count 0))
        (advice-mapc (lambda (function _properties)
                      (when (eq function (cdr entry)) (cl-incf count)))
                    (car entry))
        (should (= count 1))))))

(ert-deftest my/deadgrep-launch-filter-is-scoped ()
  (with-temp-buffer
    (deadgrep-mode)
    (let ((argv (list "rg needle" (current-buffer) "rg" "--" "needle" ".")))
      (should (eq argv (my/deadgrep--launch-arguments argv)))
      (let ((my/deadgrep--launch-context (list (current-buffer) nil nil)))
        (should (member "--max-depth=1" (my/deadgrep--launch-arguments argv)))
        (should (member "--max-depth=1" (nth 2 my/deadgrep--launch-context)))
        (with-temp-buffer
          (let ((other (list "unrelated" (current-buffer) "rg" "--" "needle" ".")))
            (should (eq other (my/deadgrep--launch-arguments other)))))))))

(defun my/deadgrep-test-wait ()
  "Wait briefly for the current test search to finish."
  (let ((deadline (+ (float-time) 5)))
    (while (and deadgrep--running (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should-not deadgrep--running)))

(ert-deftest my/deadgrep-real-ripgrep-and-clickable-restart ()
  (let* ((root (file-name-as-directory (make-temp-file "deadgrep-recursion-test-" t)))
         (deadgrep-display-buffer-function #'ignore)
         (current-prefix-arg nil)
         buffers)
    (unwind-protect
        (progn
          (make-directory (expand-file-name "sub" root))
          (with-temp-file (expand-file-name "top.txt" root) (insert "recursionneedle\n"))
          (with-temp-file (expand-file-name "sub/child.txt" root) (insert "recursionneedle\n"))
          (deadgrep "recursionneedle" root)
          (let ((buffer (get-buffer (deadgrep--buffer-name "recursionneedle" root))))
            (push buffer buffers)
            (with-current-buffer buffer
              (my/deadgrep-test-wait)
              (should my/deadgrep-recursive-p)
              (should (string-match-p "child.txt" (buffer-string)))
              (goto-char (point-min)) (search-forward "Recursive: on ")
              (button-activate (button-at (point)))
              (my/deadgrep-test-wait)
              (should-not my/deadgrep-recursive-p)
              (should (string-match-p "top.txt" (buffer-string)))
              (should-not (string-match-p "child.txt" (buffer-string)))
              (should (string-match-p "current directory only" (buffer-string)))
              (my/deadgrep-toggle-recursive)
              (my/deadgrep-test-wait)
              (should (string-match-p "child.txt" (buffer-string)))
              (my/deadgrep-set-recursive nil)
              (my/deadgrep-test-wait)))
          ;; The new buffer must start recursive even though the earlier one is off.
          (deadgrep "needle" root)
          (let ((buffer (get-buffer (deadgrep--buffer-name "needle" root))))
            (push buffer buffers)
            (with-current-buffer buffer
              (my/deadgrep-test-wait)
              (should my/deadgrep-recursive-p)
              (should (string-match-p "child.txt" (buffer-string))))))
      (mapc (lambda (buffer) (when (buffer-live-p buffer) (kill-buffer buffer))) buffers)
      (delete-directory root t))))

(ert-deftest my/deadgrep-final-arguments-preserve-search-data ()
  (with-temp-buffer
    (deadgrep-mode)
    (setq my/deadgrep-recursive-p nil)
    ;; An already-built argv must receive the limit without needing to
    ;; re-read deadgrep-extra-arguments.  Values after -- are search data.
    (should (equal
             (my/deadgrep--arguments-with-recursion
              '("--no-config" "--max-depth=8" "--type=log" "--" "--max-depth=TEXT" "."))
             '("--max-depth=1" "--no-config" "--type=log" "--" "--max-depth=TEXT" ".")))
    (setq my/deadgrep-recursive-p t)
    (should (equal
             (my/deadgrep--arguments-with-recursion '("-d" "1" "--" "needle" "."))
             '("--" "needle" ".")))))

(ert-deftest my/deadgrep-nonrecursive-log-search-actual-command-and-permissions ()
  (skip-unless (not (zerop (user-uid))))
  (let* ((root (file-name-as-directory (make-temp-file "deadgrep-permission-test-" t)))
         (restricted (expand-file-name "restricted" root))
         (term "INFO: LEO-livemount: replace fstab file")
         (deadgrep-display-buffer-function #'ignore)
         buffer)
    (unwind-protect
        (progn
          (make-directory restricted)
          (make-directory (expand-file-name "sub" root))
          (dolist (name '("top.log" "sub/child.log" "restricted/private.log"))
            (with-temp-file (expand-file-name name root) (insert term "\n")))
          (set-file-modes restricted 0)
          (let ((current-prefix-arg t)) (deadgrep term root))
          (setq buffer (get-buffer (deadgrep--buffer-name term root)))
          (with-current-buffer buffer
            (setq deadgrep--search-type 'words
                  deadgrep--file-type '(type . "log"))
            (my/deadgrep-set-recursive nil)
            (setq deadgrep--postpone-start nil)
            ;; Simulate the reported failure: no argument-builder advice.
            ;; The process boundary must still enforce the visible setting.
            (advice-remove 'deadgrep--arguments #'my/deadgrep--arguments-with-recursion)
            (unwind-protect (deadgrep-restart)
              (advice-add 'deadgrep--arguments :filter-return
                          #'my/deadgrep--arguments-with-recursion))
            (let* ((process (get-buffer-process buffer))
                   (arguments (process-command process)))
              (should (member "--max-depth=1" arguments))
              (should (member "--word-regexp" arguments))
              (should (member "--type=log" arguments))
              (should (string-match-p "--max-depth=1" deadgrep--debug-command))
              (should (equal arguments my/deadgrep--last-command))
              (my/deadgrep-test-wait)
              (should (= (process-exit-status process) 0)))
            (should (string-match-p "top.log" (buffer-string)))
            (should-not (string-match-p "child.log" (buffer-string)))
            (should-not (string-match-p "Permission denied" (buffer-string)))))
      (when (buffer-live-p buffer)
        (when-let* ((process (get-buffer-process buffer)))
          (set-process-query-on-exit-flag process nil)
          (delete-process process))
        (kill-buffer buffer))
      (set-file-modes restricted #o700)
      (delete-directory root t))))


(ert-deftest my/deadgrep-recursive-permission-errors-retain-readable-matches ()
  (skip-unless (not (zerop (user-uid))))
  (let* ((root (file-name-as-directory (make-temp-file "deadgrep-continue-" t)))
         (restricted (expand-file-name "restricted" root))
         (term "continuationneedle")
         (deadgrep-display-buffer-function #'ignore)
         (current-prefix-arg nil)
         buffer)
    (unwind-protect
        (progn
          (make-directory restricted)
          (make-directory (expand-file-name "readable" root))
          (dolist (name '("top.txt" "readable/child.txt" "restricted/private.txt"))
            (with-temp-file (expand-file-name name root) (insert term "\n")))
          (set-file-modes restricted 0)
          (deadgrep term root)
          (setq buffer (get-buffer (deadgrep--buffer-name term root)))
          (with-current-buffer buffer
            (let ((process (get-buffer-process buffer)))
              (my/deadgrep-test-wait)
              (should (= (process-exit-status process) 2)))
            (should (string-match-p "top.txt" (buffer-string)))
            (should (string-match-p "child.txt" (buffer-string)))
            (should (string-match-p "Permission denied" (buffer-string)))
            (should (string-match-p "Search finished with errors" (buffer-string)))
            (should (string-match-p "Results may be incomplete" (buffer-string)))
            (should-not (string-match-p "exited abnormally" (buffer-string)))))
      (when (buffer-live-p buffer)
        (when-let* ((process (get-buffer-process buffer)))
          (set-process-query-on-exit-flag process nil)
          (delete-process process))
        (kill-buffer buffer))
      (set-file-modes restricted #o700)
      (delete-directory root t))))

(ert-deftest my/deadgrep-error-summary-keeps-other-statuses-and-can-be-disabled ()
  (cl-letf (((symbol-function 'process-status) (lambda (_) 'exit))
            ((symbol-function 'process-exit-status) (lambda (_) 2)))
    (let ((my/deadgrep-friendly-error-summary nil))
      (should (equal
               (my/deadgrep--explain-search-errors
                (lambda (_ output) output) 'fake "exited abnormally with code 2\n")
               "exited abnormally with code 2\n")))
    (dolist (output '("finished\n" "interrupt\n" "exited abnormally with code 1\n"))
      (should (equal (my/deadgrep--explain-search-errors
                      (lambda (_ text) text) 'fake output)
                     output)))))


(defun my/deadgrep-test-insert-results ()
  "Insert a representative file heading and three result lines."
  (deadgrep-mode)
  (let ((inhibit-read-only t))
    (insert (propertize "one.txt" 'deadgrep-filename "one.txt"
                        'face 'deadgrep-filename-face) "\n")
    (dotimes (i 3)
      (insert (propertize (format "%-5d" (1+ i))
                          'deadgrep-filename "one.txt"
                          'deadgrep-line-number (1+ i)
                          'face 'deadgrep-meta-face)
              (propertize "needle" 'face 'deadgrep-match-face) "\n"))
    (insert "\n"))
  (set-buffer-modified-p nil)
  (goto-char (point-min))
  (forward-line 1))

(ert-deftest my/deadgrep-hide-and-restore-individual-lines ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (let ((text (buffer-string)) (first (point)) second)
      (my/deadgrep-hide-result)
      (setq second (point))
      (should (invisible-p first))
      (should-not (invisible-p second))
      (my/deadgrep-hide-result)
      (should (= (length my/deadgrep--hidden-results) 2))
      (should (invisible-p second))
      (my/deadgrep-unhide-result)
      (should (= (point) second))
      (should-not (invisible-p second))
      (should (invisible-p first))
      (my/deadgrep-unhide-all-results)
      (should-not (invisible-p first))
      (should-not my/deadgrep--hidden-results)
      (should (equal text (buffer-string)))
      (should-not (buffer-modified-p))
      (should-error (my/deadgrep-unhide-result) :type 'user-error)
      (goto-char (point-max))
      (should-error (my/deadgrep-hide-result) :type 'user-error))))

(ert-deftest my/deadgrep-hidden-lines-skipped-by-navigation-and-folds-independent ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (forward-line 1)
    (let ((middle (point)))
      (my/deadgrep-hide-result)
      (let ((overlay (car my/deadgrep--hidden-results)))
        (goto-char (point-min))
        (deadgrep-forward-match)
        (should (= (line-number-at-pos) 2))
        (deadgrep-forward-match)
        (should (= (line-number-at-pos) 4))
        (deadgrep-backward-match)
        (should (= (line-number-at-pos) 2))
        (goto-char (point-min))
        (deadgrep-toggle-file-results)
        (deadgrep-toggle-file-results)
        (should (overlay-buffer overlay))
        (should (invisible-p middle))
        (my/deadgrep-unhide-all-results)
        (should-not (invisible-p middle))))))

(ert-deftest my/deadgrep-hiding-is-buffer-local-and-cleared-on-rerun-or-mode-change ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (let ((first (point)))
      (my/deadgrep-hide-result)
      (with-temp-buffer
        (my/deadgrep-test-insert-results)
        (should-not my/deadgrep--hidden-results)
        (should-not (invisible-p (point)))))
    (let ((overlay (car my/deadgrep--hidden-results)))
      (deadgrep--stop-and-reset)
      (should-not (overlay-buffer overlay))
      (should-not my/deadgrep--hidden-results))
    (my/deadgrep-test-insert-results)
    (my/deadgrep-hide-result)
    (let ((overlay (car my/deadgrep--hidden-results)))
      (fundamental-mode)
      (should-not (overlay-buffer overlay)))))


(ert-deftest my/deadgrep-hide-file-includes-heading-and-stops-before-next-item ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (let ((inhibit-read-only t))
      (goto-char (point-max))
      (insert (propertize "two.txt" 'deadgrep-filename "two.txt"
                          'face 'deadgrep-filename-face) "\n")
      (insert (propertize "1    " 'deadgrep-filename "two.txt"
                          'deadgrep-line-number 1) "needle\n\n")
      (insert "rg: ./private: Permission denied (os error 13)\n\n"))
    (let ((text (buffer-string)) second error)
      (goto-char (point-min))
      (search-forward "two.txt") (beginning-of-line) (setq second (point))
      (search-forward "rg:") (beginning-of-line) (setq error (point))
      (goto-char (point-min))
      (my/deadgrep-hide-result)
      (should (invisible-p (point-min)))
      (should (invisible-p (1- second)))
      (should-not (invisible-p second))
      (should-not (invisible-p error))
      (should (= (point) second))
      (goto-char (point-min))
      (deadgrep-forward-filename)
      (should (>= (point) second))
      (my/deadgrep-unhide-result)
      (should (= (point) (point-min)))
      (should-not (invisible-p (point)))
      (should (equal text (buffer-string))))))

(ert-deftest my/deadgrep-hide-permission-error-and-restore-without-changing-text ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (let ((inhibit-read-only t))
      (goto-char (point-max))
      (insert "rg: ./private: Permission denied (os error 13)\n\n"
              "rg: ./other: Permission denied (os error 13)\n\n"
              "Search finished with errors (ripgrep exit 2). Results may be incomplete; see errors above.\n"))
    (set-buffer-modified-p nil)
    (let ((text (buffer-string)) first second)
      (goto-char (point-min)) (search-forward "rg: ./private")
      (beginning-of-line) (setq first (point))
      (my/deadgrep-hide-result)
      (setq second (point))
      (should (looking-at-p "rg: ./other"))
      (should (invisible-p first))
      (should-not (invisible-p second))
      (my/deadgrep-hide-result)
      (should (looking-at-p "Search finished with errors"))
      (my/deadgrep-unhide-result)
      (should (= (point) second))
      (should-not (invisible-p second))
      (my/deadgrep-unhide-all-results)
      (should-not (invisible-p first))
      (should (equal text (buffer-string)))
      (should-not (buffer-modified-p)))))

(ert-deftest my/deadgrep-hide-collapsed-file-preserves-tab-folding ()
  (with-temp-buffer
    (my/deadgrep-test-insert-results)
    (goto-char (point-min))
    (deadgrep-toggle-file-results)
    (my/deadgrep-hide-result)
    (should (invisible-p (point-min)))
    (my/deadgrep-unhide-result)
    (should-not (invisible-p (point-min)))
    (forward-line 1)
    (should (invisible-p (point)))
    (goto-char (point-min))
    (deadgrep-toggle-file-results)
    (forward-line 1)
    (should-not (invisible-p (point)))))

(ert-run-tests-batch-and-exit)
