;;; my-markdown-preview-tests.el --- Markdown integration checks -*- lexical-binding: t; -*-
(require 'package)
(package-initialize)
(require 'ert)
(require 'markdown-mode)
(load-file (expand-file-name "my-markdown-preview.el" (file-name-directory load-file-name)))

(ert-deftest my-markdown-export-tables-and-embedded-font ()
  (with-temp-buffer
    (markdown-mode)
    (insert "# Icons\n\n| Kind | Icon |\n|---|---|\n| Class |  |\n\n``\n")
    (let ((original (buffer-string))
          (output " *markdown-test-html*"))
      (unwind-protect
          (progn
            (markdown-standalone output)
            (should (equal (buffer-string) original))
            (with-current-buffer output
              (should (string-match-p "<table>" (buffer-string)))
              (should (string-match-p "" (buffer-string)))
              (should (string-match-p "data:font/woff2;base64," (buffer-string)))
              (should (string-match-p "unicode-range:U\\+E000-F8FF" (buffer-string)))
              (should (string-match-p "<code></code>" (buffer-string)))))
        (when (get-buffer output) (kill-buffer output))))))

(ert-deftest my-markdown-preview-routes-to-livedown-with-unsaved-content ()
  (let ((directory (make-temp-file "markdown test " t))
        (my/markdown-livedown-open-browser nil)
        command shadow)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory (file-name-as-directory directory))
          (markdown-mode)
          (insert "# Unsaved \n")
          (let ((original (buffer-string)))
            (cl-letf (((symbol-function 'make-process)
                       (lambda (&rest args)
                         (setq command (plist-get args :command))
                         (make-pipe-process :name "markdown-preview-test" :noquery t))))
              (markdown-preview))
            (setq shadow my/markdown--preview-file)
            (should (equal (nth 2 command) "start"))
            (should (equal (nth 3 command) shadow))
            (should (equal (file-name-directory shadow) default-directory))
            (should (equal original (buffer-string)))
            (should (buffer-modified-p))
            (should-not buffer-file-name)
            (insert "\nNew text")
            (should (timerp my/markdown--preview-timer))
            (cancel-timer my/markdown--preview-timer)
            (should (memq #'my/markdown--write-preview after-save-hook))
            (run-hooks 'after-save-hook)
            (with-temp-buffer
              (insert-file-contents shadow)
              (should (string-match-p "New text" (buffer-string)))
              (should (string-match-p "data:font/woff2;base64," (buffer-string)))))
          (my/markdown-preview-stop)
          (should-not (file-exists-p shadow))
          (should-not my/markdown--preview-process))
      (my/markdown-preview-stop)
      (delete-directory directory t))))

(ert-deftest my-markdown-font-css-is-cached ()
  (let ((my/markdown--font-cache nil))
    (should (eq (my/markdown--font-style) (my/markdown--font-style)))))

(ert-deftest my-markdown-atomic-preview-publishes-complete-file ()
  (let* ((directory (make-temp-file "markdown-atomic-" t))
         (my/markdown--preview-file (expand-file-name "preview.md" directory)))
    (unwind-protect
        (with-temp-buffer
          (insert "Updated text")
          (let ((my/markdown--preview-buffer (current-buffer))
                (rename (symbol-function 'rename-file)) committed)
            (with-temp-file my/markdown--preview-file (insert "Previous complete text"))
            (cl-letf (((symbol-function 'rename-file)
                       (lambda (source target &optional overwrite)
                         (should (equal (file-name-directory source) (file-name-directory target)))
                         (should (equal (with-temp-buffer (insert-file-contents target) (buffer-string))
                                        "Previous complete text"))
                         (should (with-temp-buffer (insert-file-contents source)
                                                   (search-forward "Updated text" nil t)))
                         (setq committed t)
                         (funcall rename source target overwrite))))
              (my/markdown--write-preview))
            (should committed)
            (should-not (directory-files directory nil "livedown-write-"))))
      (delete-directory directory t))))

(ert-deftest my-markdown-failed-update-keeps-last-preview ()
  (let* ((directory (make-temp-file "markdown-atomic-failure-" t))
         (my/markdown--preview-file (expand-file-name "preview.md" directory)))
    (unwind-protect
        (with-temp-buffer
          (insert "New text")
          (let ((my/markdown--preview-buffer (current-buffer)))
            (with-temp-file my/markdown--preview-file (insert "Previous complete text"))
            (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (error "Rename failed"))))
              (should-error (my/markdown--write-preview)))
            (should (equal (with-temp-buffer (insert-file-contents my/markdown--preview-file) (buffer-string))
                           "Previous complete text"))
            (should-not (directory-files directory nil "livedown-write-"))))
      (delete-directory directory t))))

(ert-deftest my-markdown-selects-xwidget-and-waits-for-server ()
  (let ((directory (make-temp-file "markdown-browser-" t))
        (my/markdown-livedown-open-browser t)
        (my/markdown-preview-browser 'auto))
    (unwind-protect
        (dolist (available '(t nil))
          (with-temp-buffer
            (setq default-directory (file-name-as-directory directory))
            (markdown-mode) (insert "# Preview")
            (let (command filter scheduled (count 0) opened)
              (cl-letf (((symbol-function 'my/markdown--xwidget-available-p) (lambda (&rest _) available))
                        ((symbol-function 'make-process)
                         (lambda (&rest args)
                           (setq command (plist-get args :command) filter (plist-get args :filter))
                           (make-pipe-process :name "markdown-browser-test" :noquery t)))
                        ((symbol-function 'run-at-time)
                         (lambda (_delay _repeat fn &rest args)
                           (setq scheduled (cons fn args) count (1+ count)))))
                (my/markdown-livedown-preview)
                (should (eq (and (member "--open" command) t) (not available)))
                (let ((process my/markdown--preview-process))
                  (funcall filter process "[livedown] markdowning started ")
                  (should-not scheduled)
                  (funcall filter process "on http://localhost:1337\n")
                  (funcall filter process "[livedown] markdowning started on http://localhost:1337\n")
                  (if available
                      (progn
                        (should (= count 1))
                        (cl-letf (((symbol-function 'xwidget-webkit-browse-url)
                                   (lambda (&rest args) (setq opened args))))
                          (apply (car scheduled) (cdr scheduled)))
                        (should (equal opened '("http://localhost:1337" t))))
                    (should-not scheduled))))
              (my/markdown-preview-stop))))
      (my/markdown-preview-stop)
      (delete-directory directory t))))

(ert-deftest my-markdown-xwidget-failure-falls-back-externally ()
  (require 'browse-url)
  (let* ((my/markdown--preview-process (make-pipe-process :name "markdown-fallback-test" :noquery t))
         opened)
    (unwind-protect
        (cl-letf (((symbol-function 'xwidget-webkit-browse-url) (lambda (&rest _) (error "WebKit unavailable")))
                  ((symbol-function 'browse-url-default-browser) (lambda (url &rest _) (setq opened url))))
          (my/markdown--open-internal-preview my/markdown--preview-process (selected-frame) "http://localhost:1337")
          (should (equal opened "http://localhost:1337")))
      (delete-process my/markdown--preview-process))))

(ert-run-tests-batch-and-exit)
