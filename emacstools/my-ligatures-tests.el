;;; my-ligatures-tests.el --- Display configuration checks -*- lexical-binding: t; -*-
(require 'package)
(package-initialize)
(require 'ert)
(require 'cl-lib)
(load-file (expand-file-name "my-ligatures.el" (file-name-directory load-file-name)))
(ert-deftest personal-ligature-preserves-source-and-selects-derived-modes ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "a != b && c -> d == e")
    (set-buffer-modified-p nil)
    (let ((source (buffer-string)))
      (ligature-mode 1)
      (should (equal (buffer-string) source))
      (should-not (buffer-modified-p))
      (should (string-match-p (aref (car (aref composition-function-table ?-)) 0) "->"))
      (should (aref composition-function-table ?!))
      (should (string-match-p (aref (car (aref composition-function-table ?=)) 0) "=="))
      (ligature-mode -1)
      (should (equal (buffer-string) source)))))
(ert-deftest personal-ligature-configuration-is-idempotent-and-scoped ()
  (my/apply-ligatures)
  (my/apply-ligatures)
  (should (= 1 (cl-count my/ligature-modes ligature-composition-table :key #'car :test #'equal)))
  (with-temp-buffer
    (special-mode)
    (ligature-mode 1)
    (should-not (aref composition-function-table ?-)))
  (let ((my/ligature-modes t))
    (my/apply-ligatures)
    (should (assq t ligature-composition-table))
    (with-temp-buffer
      (special-mode)
      (ligature-mode 1)
      (should (aref composition-function-table ?-))))
  (my/apply-ligatures)
  (should-not (assq t ligature-composition-table)))
(ert-deftest personal-ligature-disabled-setting ()
  (let ((my/ligatures-enabled nil))
    (my/apply-ligatures)
    (should-not global-ligature-mode))
  (my/apply-ligatures)
  (should global-ligature-mode))
(ert-deftest personal-ligature-face-overrides-syntax-and-is-removed-on-disable ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (font-lock-mode 1)
    (insert "\"a != b && c -> d == e\"")
    (set-buffer-modified-p nil)
    (ligature-mode 1)
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "!=")
    (should (memq 'my/ligature-symbol (ensure-list (get-text-property (1- (point)) 'face))))
    (should (equal (face-attribute 'my/ligature-symbol :foreground nil t) "#D0D0D0"))
    (should (eq (face-attribute 'my/ligature-symbol :weight nil t) 'bold))
    (should-not (buffer-modified-p))
    (ligature-mode -1)
    (font-lock-ensure)
    (should-not (memq 'my/ligature-symbol (ensure-list (get-text-property (1- (point)) 'face))))
    (should-not (buffer-modified-p))))
(ert-deftest personal-ligature-face-updates-after-editing-and-can-be-disabled ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (font-lock-mode 1)
    (insert "a != b")
    (ligature-mode 1)
    (font-lock-ensure)
    (goto-char 4)
    (insert " ")
    (font-lock-ensure)
    (should-not (memq 'my/ligature-symbol (ensure-list (get-text-property 3 'face))))
    (let ((my/ligatures-highlight nil))
      (my/ligatures--sync-style)
      (font-lock-ensure)
      (should-not (memq 'my/ligature-symbol (ensure-list (get-text-property 3 'face)))))))
(ert-deftest personal-ligature-arrow-gap-is-display-only-and-cleans-up ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (font-lock-mode 1)
    (insert "item->r other-> r next=>value")
    (set-buffer-modified-p nil)
    (let ((source (buffer-string)))
      (ligature-mode 1)
      (font-lock-ensure)
      (let ((gaps (cl-remove-if-not (lambda (o) (overlay-get o 'my/ligature-gap))
                                    (overlays-in (point-min) (point-max)))))
        (should (= (length gaps) 2))
        (should (equal (get-text-property 0 'display (overlay-get (car gaps) 'before-string))
                       '(space :width 0.2))))
      (should (equal (buffer-string) source))
      (should-not (buffer-modified-p))
      (ligature-mode -1)
      (should-not (cl-some (lambda (o) (overlay-get o 'my/ligature-gap))
                          (overlays-in (point-min) (point-max)))))))
(ert-deftest personal-ligature-arrow-gap-updates-after-edit-and-can-be-disabled ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (font-lock-mode 1)
    (insert "item->r")
    (ligature-mode 1)
    (font-lock-ensure)
    (should (cl-some (lambda (o) (overlay-get o 'my/ligature-gap)) (overlays-at 7)))
    (goto-char 7)
    (insert " ")
    (font-lock-ensure)
    (should-not (cl-some (lambda (o) (overlay-get o 'my/ligature-gap))
                        (overlays-in (point-min) (point-max))))
    (delete-char -1)
    (font-lock-ensure)
    (should (cl-some (lambda (o) (overlay-get o 'my/ligature-gap)) (overlays-at 7)))
    (let ((my/ligature-arrow-gap 0))
      (my/ligatures--sync-style)
      (font-lock-ensure)
      (should-not (cl-some (lambda (o) (overlay-get o 'my/ligature-gap))
                          (overlays-in (point-min) (point-max)))))))
(ert-deftest personal-ligature-face-wins-over-later-eglot-semantic-operator ()
  (require 'eglot)
  (with-temp-buffer
    (insert "int main() { if(rc != 0) return rc; }")
    (if (and (fboundp 'treesit-language-available-p)
             (treesit-language-available-p 'cpp))
        (c++-ts-mode)
      (c++-mode))
    (font-lock-mode 1)
    (ligature-mode 1)
    ;; Eglot appends a matcher that prepends this face after our setup.
    (font-lock-add-keywords nil '(("!=" (0 'eglot-semantic-operator prepend))) 'append)
    (font-lock-ensure)
    (goto-char (point-min)) (search-forward "!=")
    (let ((faces (ensure-list (get-text-property (- (point) 2) 'face))))
      (should (eq (car faces) 'my/ligature-symbol))
      (should (memq 'eglot-semantic-operator faces)))
    ;; Toggling off must retain the language server's semantic face.
    (ligature-mode -1)
    (font-lock-ensure)
    (should (eq (car (ensure-list (get-text-property (- (point) 2) 'face)))
                'eglot-semantic-operator))))
(ert-deftest personal-ligature-fontifier-preserves-expanded-bounds-and-return-value ()
  (with-temp-buffer
    (insert "a != b")
    (let ((my/ligatures--style-regexp "!=")
          (my/ligatures--arrow-regexp nil)
          (result '(jit-lock-bounds 1 . 7)))
      (should (eq (my/ligatures--fontify-after
                   (lambda (&rest _) result) 4 5 nil) result))
      (should (eq (car (ensure-list (get-text-property 3 'face))) 'my/ligature-symbol)))))
(ert-run-tests-batch-and-exit)
