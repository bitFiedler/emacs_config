;;; my-startup-performance-tests.el --- Isolated startup checks -*- lexical-binding: t; -*-
(defconst my/export-test-directory (file-name-directory (or load-file-name buffer-file-name)))
(require 'ert)
(require 'package)
(package-initialize)
(require 'use-package)

(ert-deftest my/startup-gc-boost-restores-settings-and-safe-manual-reload ()
  (let ((after-init-time nil)
        (gc-cons-threshold 800000)
        (gc-cons-percentage 0.1)
        (emacs-startup-hook nil))
    (load-file (expand-file-name "my-startup-performance.el" my/export-test-directory))
    (should (= gc-cons-threshold (* 64 1024 1024)))
    (should (= gc-cons-percentage 0.6))
    (run-hooks 'emacs-startup-hook)
    (should (= gc-cons-threshold 800000))
    (should (= gc-cons-percentage 0.1))
    (should (integerp my/startup--gc-count))
    (let ((after-init-time (current-time)))
      (load-file (expand-file-name "my-startup-performance.el" my/export-test-directory))
      (should (= gc-cons-threshold 800000))
      (should (= gc-cons-percentage 0.1)))))

(ert-deftest my/startup-lazy-commands-keep-bindings-and-first-load-configuration ()
  ;; Read only the declarations under test; never run the complete init,
  ;; language-server hooks, preview processes or package installers.
  (let ((use-package-ensure-function (lambda (&rest _) t))
        (selected '(vundo multiple-cursors helm helm-gtags helm-xref helm-rg
                    helm-ls-git helm-company helm-flycheck helm-fuzzy helm-lsp
                    helm-ispell helm-bm deadgrep magit magit-gitflow elpy pyvenv)))
    (dolist (file (list (expand-file-name "../.emacs" my/export-test-directory) (expand-file-name "python_config.el" my/export-test-directory)))
      (with-temp-buffer
        (insert-file-contents file)
        (condition-case nil
            (while t
              (let ((form (read (current-buffer))))
                (when (and (eq (car-safe form) 'use-package)
                           (memq (cadr form) selected))
                  (eval form t))))
          (end-of-file nil))))
    (dolist (feature (remove 'helm-xref (remove 'helm selected)))
      (should-not (featurep feature)))
    (should-not (featurep 'lsp-mode))
    (should (eq (key-binding (kbd "M-s")) 'deadgrep))
    (should (eq (key-binding (kbd "C-c u")) 'vundo))
    (should (eq (key-binding (kbd "C->")) 'mc/mark-next-like-this))
    (should (= undo-outer-limit 360000000))
    (should (equal python-shell-interpreter "python3"))
    (should (memq 'helm-gtags-mode c++-ts-mode-hook))
    (autoload-do-load (symbol-function 'vundo) 'vundo)
    (should (featurep 'vundo))
    (should (equal vundo-glyph-alist vundo-unicode-symbols))
    (autoload-do-load (symbol-function 'deadgrep) 'deadgrep)
    (should (featurep 'my-deadgrep-recursion))
    (should (eq (lookup-key deadgrep-mode-map (kbd "z")) 'my/deadgrep-hide-result))
    (autoload-do-load (symbol-function 'magit-status) 'magit-status)
    (should (featurep 'magit))
    (should (featurep 'magit-gitflow))
    (should-not magit-log-color-graph-limit)
    (autoload-do-load (symbol-function 'helm-gtags-mode) 'helm-gtags-mode)
    (should (eq (lookup-key helm-gtags-mode-map (kbd "C-.")) 'helm-gtags-dwim))
    (load-file (expand-file-name "org_config.el" my/export-test-directory))
    (should-not (featurep 'org))
    (should (commandp 'org-store-link))
    (should (commandp 'org-agenda))
    (with-temp-buffer
      (org-mode)
      (should org-indent-mode)
      (should org-superstar-mode)
      (should (featurep 'org-tempo)))))

(ert-deftest my/startup-terminal-waits-are-scoped-and-optional ()
  (let ((xterm-query-timeout 2)
        (xterm-query-redisplay-timeout 0.2)
        (my/startup-terminal-query-timeout 0.2))
    (should (equal (my/startup--terminal-init
                    (lambda () (list xterm-query-timeout xterm-query-redisplay-timeout)))
                   '(0.2 0.05)))
    (should (= xterm-query-timeout 2))
    (should (= xterm-query-redisplay-timeout 0.2))
    (let ((my/startup-terminal-query-timeout nil))
      (should (equal (my/startup--terminal-init
                      (lambda () (list xterm-query-timeout xterm-query-redisplay-timeout)))
                     '(2 0.2))))
    (let ((xterm-query-timeout nil))
      (should-not (my/startup--terminal-init (lambda () xterm-query-timeout))))
    (should (numberp my/startup--terminal-seconds))))

(ert-deftest my/startup-terminal-unanswered-queries-retain-async-handler ()
  (require 'term/xterm)
  (let ((input-decode-map (make-sparse-keymap))
        (my/startup-terminal-query-timeout 0.2)
        sent)
    (cl-letf (((symbol-function 'send-string-to-terminal)
               (lambda (query &rest _) (setq sent query)))
              ((symbol-function 'discard-input) #'ignore)
              ((symbol-function 'input-pending-p) (lambda () nil))
              ((symbol-function 'read-event) (lambda (&rest _) nil)))
      (my/startup--terminal-init
       (lambda () (xterm--query "query" '(("answer" . ignore)))))
      (should (equal sent "query"))
      (should (functionp (lookup-key input-decode-map "answer"))))))

(ert-deftest my/startup-profile-nested-times-preserve-returns-and-errors ()
  (let ((my/startup--profile-data (make-hash-table :test #'equal))
        (my/startup--profile-child-time nil)
        (times '(0.0 1.0 3.0 5.0)))
    (cl-letf (((symbol-function 'float-time) (lambda (&rest _) (pop times))))
      (should (eq
               (my/startup--profile-call
                (lambda ()
                  (my/startup--profile-call (lambda () 'answer) "child" "library" nil))
                "parent" "init" nil)
               'answer)))
    (should (equal (gethash '("parent" "init") my/startup--profile-data) [1 5.0 3.0]))
    (should (equal (gethash '("child" "library") my/startup--profile-data) [1 2.0 2.0]))
    (should-error
     (my/startup--profile-call (lambda () (error "Expected test error")) "load" "broken" nil))
    (should (= (aref (gethash '("load" "broken") my/startup--profile-data) 0) 1))))

(ert-deftest my/startup-profile-integration-removes-advice-and-omits-process-args ()
  (let ((my/startup--profile-data nil)
        (my/startup--profile-active nil)
        (my/startup--profile-child-time nil)
        (file (make-temp-file "my-startup-profile-" nil ".el")))
    (unwind-protect
        (progn
          (with-temp-file file (insert ";;; -*- lexical-binding: t; -*-\n(+ 1 2)\n"))
          (my/startup--profile-start)
          (my/startup--profile-start)
          (load file nil t)
          (require 'subr-x)
          (executable-find "my-startup-test-unavailable-program")
          (my/startup--profile-process (lambda (&rest _) t)
                                      "test-program" nil nil nil "private-argument")
          (my/startup--profile-stop)
          (should (gethash (list "load" file) my/startup--profile-data))
          (should (gethash '("require" "subr-x") my/startup--profile-data))
          (should (gethash '("executable-find" "my-startup-test-unavailable-program")
                           my/startup--profile-data))
          (dolist (entry my/startup--profile-advices)
            (should-not (advice-member-p (cdr entry) (car entry))))
          (save-window-excursion
            (my/startup-profile-report)
            (with-current-buffer "*Emacs Startup Profile*"
              (should buffer-read-only)
              (should (string-match-p "test-program" (buffer-string)))
              (should-not (string-match-p "private-argument" (buffer-string))))))
      (my/startup--profile-stop)
      (delete-file file)
      (when (get-buffer "*Emacs Startup Profile*")
        (kill-buffer "*Emacs Startup Profile*")))))

(ert-deftest my/startup-wsl-native-lookup-keeps-windows-commands-and-path-settings ()
  (let* ((root (make-temp-file "startup-exec-path-" t))
         (native (expand-file-name "native" root))
         (windows (expand-file-name "windows" root))
         (my/startup-wsl-windows-directory-regexp
          (concat "\\`" (regexp-quote windows) "\\(?:/\\|\\'\\)"))
         (my/startup-wsl-keep-exec-directories nil)
         (my/startup--wsl-skipped-dirs nil)
         (saved-path (getenv "PATH")))
    (unwind-protect
        (progn
          (make-directory native) (make-directory windows)
          (dolist (file (list (expand-file-name "native-tool" native)
                              (expand-file-name "mounted-tool" windows)
                              (expand-file-name "notepad.exe" windows)))
            (with-temp-file file (insert "#!/bin/sh\nexit 0\n"))
            (set-file-modes file #o755))
          (let ((exec-path (list native windows)))
            (should (equal (my/startup--wsl-executable-find #'executable-find "native-tool")
                           (expand-file-name "native-tool" native)))
            (should-not (my/startup--wsl-executable-find #'executable-find "mounted-tool"))
            (should (equal (my/startup--wsl-executable-find #'executable-find "notepad.exe")
                           (expand-file-name "notepad.exe" windows)))
            (should (equal
                     (my/startup--wsl-executable-find
                      #'executable-find (expand-file-name "mounted-tool" windows))
                     (expand-file-name "mounted-tool" windows)))
            ;; A remote-aware request must retain its original lookup policy.
            (should (equal
                     (my/startup--wsl-executable-find
                      (lambda (_command remote) (list remote exec-path)) "tool" t)
                     (list t (list native windows))))
            (let ((my/startup-wsl-keep-exec-directories (list windows)))
              (should (equal (my/startup--wsl-executable-find #'executable-find "mounted-tool")
                             (expand-file-name "mounted-tool" windows))))
            (should (equal exec-path (list native windows)))
            (should (equal (getenv "PATH") saved-path))
            (should (equal my/startup--wsl-skipped-dirs (list windows)))))
      (delete-directory root t))))

(ert-deftest my/startup-wsl-advice-is-removed-at-startup-checkpoint ()
  (let ((process-environment (copy-sequence process-environment))
        (after-init-time nil)
        (emacs-startup-hook nil))
    (setenv "WSL_DISTRO_NAME" "TestDistribution")
    (setenv "EMACS_STARTUP_PROFILE" nil)
    (unwind-protect
        (progn
          (load-file (expand-file-name "my-startup-performance.el" my/export-test-directory))
          (should (advice-member-p #'my/startup--wsl-executable-find 'executable-find))
          (run-hooks 'emacs-startup-hook)
          (should-not (advice-member-p #'my/startup--wsl-executable-find 'executable-find))
          (let ((my/startup-wsl-native-executable-lookups nil))
            (load-file (expand-file-name "my-startup-performance.el" my/export-test-directory))
            (should-not (advice-member-p #'my/startup--wsl-executable-find 'executable-find)))
          (run-hooks 'emacs-startup-hook))
      (my/startup-finish))))

(ert-deftest my/startup-wsl-detection-does-not-match-ordinary-linux ()
  (let ((process-environment (copy-sequence process-environment)))
    (setenv "WSL_DISTRO_NAME" nil) (setenv "WSL_INTEROP" nil)
    (cl-letf (((symbol-function 'insert-file-contents)
               (lambda (&rest _) (insert "6.8.0-generic"))))
      (should-not (my/startup--wsl-p)))
    (cl-letf (((symbol-function 'insert-file-contents)
               (lambda (&rest _) (insert "6.6.87.2-microsoft-standard-WSL2"))))
      (should (my/startup--wsl-p)))))

(ert-run-tests-batch-and-exit)
