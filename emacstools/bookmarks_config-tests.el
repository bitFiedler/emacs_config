;;; bookmarks_config-tests.el --- Bookmark display checks -*- lexical-binding: t; -*-
(require 'package)
(package-initialize)
(require 'use-package)
(require 'ert)
(require 'cl-lib)
(defconst my/bookmarks-test-directory (file-name-directory load-file-name))
(load-file (expand-file-name "bookmarks_config.el" my/bookmarks-test-directory))

(defmacro my/bookmarks-test-window (&rest body)
  (declare (indent 0))
  `(save-window-excursion
     (with-temp-buffer
       (rename-buffer "bookmark-test-editing" t)
       (switch-to-buffer (current-buffer))
       (insert "first line\nsecond line\nthird line\n")
       (goto-char (point-min))
       (unwind-protect
           (progn ,@body)
         (bm-remove-all-current-buffer)
         (my/bookmarks-refresh-terminal-markers)))))

(ert-deftest my/bookmarks-blends-standard-rgb-before-terminal-quantization ()
  (cl-letf (((symbol-function 'face-background) (lambda (&rest _) "#202020"))
            ((symbol-function 'color-name-to-rgb) (lambda (&rest _) '(1.0 0.0 0.0))))
    (should (equal (my/bookmarks-line-background (selected-frame)) "#48311a"))
    (should (equal (my/bookmarks-color-rgb "DarkOrange1") '(1.0 0.4980392156862745 0.0)))))

(ert-deftest my/bookmarks-high-color-tty-uses-the-gui-orange-and-tint ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
            ((symbol-function 'display-color-cells) (lambda (&rest _) 256)))
    (my/bookmarks-refresh-appearance)
    (should (equal (face-attribute 'my/bookmark-terminal-marker :foreground) "#ff7f00"))
    (should (equal (face-attribute 'bm-face :background)
                   (my/bookmarks-line-background (selected-frame))))
    (should (eq (face-attribute 'bm-face :foreground) 'unspecified))))

(ert-deftest my/bookmarks-limited-color-tty-uses-readable-yellow ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
            ((symbol-function 'display-color-cells) (lambda (&rest _) 16)))
    (my/bookmarks-refresh-appearance)
    (should (equal (face-attribute 'my/bookmark-terminal-marker :foreground) "yellow"))
    (should (equal (face-attribute 'bm-face :background) "yellow"))
    (should (equal (face-attribute 'bm-face :foreground) "black"))))

(ert-deftest my/bookmarks-terminal-marker-preserves-text-and-existing-margins ()
  (my/bookmarks-test-window
    (let ((my/bookmark-terminal-symbol "B")
          (source (buffer-string))
          (window (selected-window)))
      (set-window-margins window 3 1)
      (set-buffer-modified-p nil)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
        (bm-bookmark-add)
        (should (equal (window-margins window) '(3 . 1)))
        (should (= (length my/bookmarks--terminal-overlays) 1))
        (let* ((marker (car my/bookmarks--terminal-overlays))
               (display (get-text-property 0 'display (overlay-get marker 'before-string))))
          (should (eq (overlay-get marker 'window) window))
          (should (equal (car display) '(margin left-margin)))
          (should (equal (substring-no-properties (cadr display)) "B")))
        (should (equal (buffer-string) source))
        (should-not (buffer-modified-p))
        (bm-bookmark-remove)
        (should-not my/bookmarks--terminal-overlays)
        (should (equal (window-margins window) '(3 . 1)))))))

(ert-deftest my/bookmarks-gui-keeps-fringe-marker-without-adding-margins ()
  (my/bookmarks-test-window
    (set-window-margins nil 3 1)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t)))
      (let* ((bookmark (bm-bookmark-add))
             (display (get-text-property 0 'display (overlay-get bookmark 'before-string))))
        (should (eq (car display) 'left-fringe))
        (should-not my/bookmarks--terminal-overlays)
        (should (equal (window-margins) '(3 . 1)))))))

(ert-deftest my/bookmarks-terminal-markers-follow-window-buffer-switches ()
  (my/bookmarks-test-window
    (let ((source (current-buffer))
          (other (generate-new-buffer " bookmark-other")))
      (unwind-protect
          (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
            (bm-bookmark-add)
            (should my/bookmarks--terminal-overlays)
            (switch-to-buffer other)
            (my/bookmarks-refresh-terminal-markers)
            (should-not my/bookmarks--terminal-overlays)
            (should-not (window-parameter nil 'my/bookmark-original-margins))
            (switch-to-buffer source)
            (my/bookmarks-refresh-terminal-markers)
            (should (= (length my/bookmarks--terminal-overlays) 1)))
        (switch-to-buffer source)
        (kill-buffer other)))))

(ert-deftest my/bookmarks-terminal-marker-follows-edits-and-can-be-disabled ()
  (my/bookmarks-test-window
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
      (let ((bookmark (bm-bookmark-add)))
        (insert "new text")
        (should (= (overlay-start (car my/bookmarks--terminal-overlays)) (overlay-start bookmark)))
        (should (= (overlay-end (car my/bookmarks--terminal-overlays)) (overlay-end bookmark)))
        (let ((my/bookmark-terminal-markers nil))
          (my/bookmarks-refresh-terminal-markers)
          (should-not my/bookmarks--terminal-overlays)
          (should-not (window-parameter nil 'my/bookmark-original-margins)))))))

(ert-deftest my/bookmarks-reload-does-not-duplicate-upstream-advice ()
  (load-file (expand-file-name "bookmarks_config.el" my/bookmarks-test-directory))
  (let ((count 0))
    (advice-mapc (lambda (function _properties)
                  (when (eq function #'my/bookmarks-refresh-terminal-markers)
                    (setq count (1+ count)))) 'bm-bookmark-add)
    (should (= count 1))))

(ert-deftest my/bookmarks-terminal-column-stays-fixed-while-toggling-bookmarks ()
  (my/bookmarks-test-window
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
      (set-window-margins nil 0 0)
      (my/bookmarks-refresh-terminal-markers)
      (let ((width (window-body-width))
            (margins (window-margins)))
        (should (equal margins '(1)))
        (bm-bookmark-add)
        (should (= width (window-body-width)))
        (should (equal margins (window-margins)))
        (bm-bookmark-remove)
        (should (= width (window-body-width)))
        (should (equal margins (window-margins)))
        (should (eq (face-attribute 'my/bookmark-terminal-marker :weight) 'normal))))))

(ert-deftest my/bookmarks-full-line-option-updates-existing-bookmarks ()
  (my/bookmarks-test-window
    (let* ((bookmark (bm-bookmark-add))
           (bounds (cons (overlay-start bookmark) (overlay-end bookmark)))
           (source (buffer-string)))
      (unwind-protect
          (dolist (enabled '(nil t))
            (let ((my/bookmark-highlight-full-line enabled))
              (my/bookmarks-refresh-appearance)
              (dolist (face '(bm-face bm-persistent-face))
                (should (eq (face-attribute face :extend) enabled))
                (should (eq (face-attribute face :extend t) enabled)))
              (should (eq (bm-bookmark-at (point-min)) bookmark))
              (should (equal (cons (overlay-start bookmark) (overlay-end bookmark)) bounds))
              (should (equal source (buffer-string)))))
        (my/bookmarks-refresh-appearance)))))

(ert-run-tests-batch-and-exit)
